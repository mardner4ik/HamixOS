+			data->tlsIndex = target->tlsIndex;
+			data->addend = symValue + rel.addend_norel();
+			slot[0] = reinterpret_cast<uintptr_t>(&__mlibcTlsdescDynamic);
+			slot[1] = reinterpret_cast<uintptr_t>(data);
+		}
+	} break;
+#endif
