+int posix_spawn_file_actions_addclosefrom_np(posix_spawn_file_actions_t *file_actions,
+		int from) {
+	if(from < 0)
+		return EBADF;
+	struct fdop *op = (struct fdop *)malloc(sizeof *op);
+	if(!op)
