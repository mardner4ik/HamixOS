#!/bin/bash
out="${1:-$HOME/hwreport-$(date +%Y%m%d-%H%M%S).txt}"
section() {
    printf '\n===== %s =====\n' "$1"
    shift
    "$@" 2>&1
}
show() {
    [ -r "$1" ] && cat "$1" || echo "(no $1)"
}
pci() {
    for d in /sys/bus/pci/devices/*; do
        [ -d "$d" ] || continue
        printf '%s vendor=%s device=%s class=%s irq=%s\n' "${d##*/}" "$(cat $d/vendor 2>/dev/null)" "$(cat $d/device 2>/dev/null)" "$(cat $d/class 2>/dev/null)" "$(cat $d/irq 2>/dev/null)"
    done
}
{
    echo "HamixOS hardware report"
    date
    uname -a
    section "os-release" show /etc/os-release
    section "kernel command line" show /proc/cmdline
    section "boot units (hxinit)" show /proc/hxinit
    section "processor" show /proc/cpuinfo
    section "memory" show /proc/meminfo
    section "PCI devices" pci
    section "drivers" show /proc/drivers
    section "modules" show /proc/modules
    section "interrupts" show /proc/interrupts
    section "USB" show /proc/usb
    section "graphics" show /proc/gpu
    section "audio" show /proc/audio
    section "disks" show /proc/partitions
    section "mounts" show /proc/mounts
    section "kernel log" show /proc/dmesg
} > "$out"
echo "Report written to $out ($(wc -c < "$out") bytes)."
media=$(awk '$2 ~ "^/(media|mnt)/" {print $2}' /proc/mounts 2>/dev/null)
if [ -n "$media" ]; then
    echo "Copy it to a USB stick, e.g.: cp \"$out\" ${media%%$'\n'*}/"
else
    echo "To send it, plug in a USB stick (it appears under /media) and copy the file there."
fi
