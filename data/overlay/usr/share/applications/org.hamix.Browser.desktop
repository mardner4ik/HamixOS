[Desktop Entry]
Type=Application
Name=hxsurf
Name[uk]=hxsurf
Comment=hxsurf web browser
Comment[uk]=Веб-браузер hxsurf
Keywords=web;browser;internet;surf;hxsurf;
Exec=/usr/bin/hxsurf %U
Icon=web-browser
Terminal=false
X-Nook-Key=browser
X-Nook-Order=15
Categories=Network;WebBrowser;
X-Nook-Role=browser
X-Nook-Dock=true
X-Hamix-Permissions=network
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
