#!/bin/busybox sh
description="Demo OpenRC-style daemon"
case "$1" in
    start)
        (while true; do sleep 1; done) > /dev/null 2>&1 &
        echo $! > /tmp/openrc-demo.pid
        ;;
    status)
        kill -0 "$(cat /tmp/openrc-demo.pid 2>/dev/null)" 2>/dev/null
        ;;
    stop)
        kill "$(cat /tmp/openrc-demo.pid)"
        ;;
esac
