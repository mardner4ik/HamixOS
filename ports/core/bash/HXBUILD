pkgname=bash
pkgver=5.2.37
pkgdesc="GNU Bourne-Again SHell, the HamixOS login shell"
source="https://ftp.gnu.org/gnu/bash/bash-$pkgver.tar.gz"
sha256="9599b22ecd1d5787ad7d3b7bf0c59f312b3396d1e281175dd1f8a4014da621ff"
builddir="bash-$pkgver"
depends=""

build() {
    sed -i 's|^/\* #define SYS_BASHRC "/etc/bash.bashrc" \*/|#define SYS_BASHRC "/etc/bash.bashrc"|' config-top.h
    export bash_cv_getcwd_malloc=yes bash_cv_func_sigsetjmp=present bash_cv_job_control_missing=present \
        bash_cv_sys_named_pipes=present bash_cv_func_strcoll_broken=no bash_cv_printf_a_format=yes \
        bash_cv_unusable_rtsigs=no bash_cv_dev_fd=absent bash_cv_dev_stdin=absent bash_cv_must_reinstall_sighandlers=no \
        bash_cv_func_snprintf=yes bash_cv_func_vsnprintf=yes bash_cv_wcwidth_broken=no bash_cv_fnmatch_equiv_fallback=yes \
        bash_cv_pgrp_pipe=no bash_cv_termcap_lib=gnutermcap bash_cv_func_ctype_nonascii=no \
        ac_cv_func_mmap_fixed_mapped=yes ac_cv_rl_version=8.2
    CFLAGS="$CFLAGS -std=gnu17 -Wno-implicit-function-declaration -Wno-int-conversion -fcommon" CC_FOR_BUILD=gcc CFLAGS_FOR_BUILD="-O2 -std=gnu17" ./configure --host="$HX_HOST" --build="$HX_BUILD" --prefix=/usr --bindir=/usr/bin \
        --without-bash-malloc --disable-nls --without-curses --enable-readline --enable-history \
        --enable-job-control --disable-net-redirections --enable-static-link=no \
        --with-installed-readline=no
    make -j"$JOBS" CC_FOR_BUILD=gcc CFLAGS_FOR_BUILD="-O2 -std=gnu17"
}

package() {
    install -Dm755 bash "$pkgdir/usr/bin/bash"
}
