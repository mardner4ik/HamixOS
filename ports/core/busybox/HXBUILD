pkgname=busybox
pkgver=1.37.0
pkgdesc="Busybox (shell and core utilities) built against hxlibc"
source="https://busybox.net/downloads/busybox-$pkgver.tar.bz2"
sha256="3311dff32e746499f4df0d5df04d7eb396382d7e108bb9250e7b519b837043a4"
builddir="busybox-$pkgver"
depends=""

applets="FEATURE_FANCY_SLEEP FLOAT_DURATION FEATURE_SEAMLESS_GZ FEATURE_TAR_AUTODETECT FEATURE_TAR_LONG_OPTIONS ASH ASH_BASH_COMPAT ASH_JOB_CONTROL ASH_ALIAS ASH_RANDOM_SUPPORT ASH_EXPAND_PRMT ASH_ECHO ASH_PRINTF ASH_TEST ASH_GETOPTS ASH_CMDCMD SH_IS_ASH
 FEATURE_EDITING FEATURE_EDITING_HISTORY FEATURE_TAB_COMPLETION FEATURE_SH_MATH
 CAT CP MV RM LS FEATURE_LS_FILETYPES FEATURE_LS_FOLLOWLINKS FEATURE_LS_RECURSIVE FEATURE_LS_SORTFILES FEATURE_LS_TIMESTAMPS FEATURE_LS_USERNAME FEATURE_LS_COLOR
 MKDIR RMDIR LN TOUCH ECHO PRINTF TEST TEST1 TEST2 TRUE FALSE PWD BASENAME DIRNAME HEAD TAIL WC SORT UNIQ CUT TR TEE SEQ YES SLEEP DATE ID WHOAMI ENV EXPR
 CHMOD CHOWN STAT DU DF SYNC UNAME HOSTNAME MD5SUM SHA1SUM SHA256SUM OD HEXDUMP XXD DD CMP DIFF REALPATH READLINK MKTEMP WHICH XARGS
 GREP EGREP FGREP FEATURE_GREP_CONTEXT SED AWK FIND FEATURE_FIND_PRINT0 FEATURE_FIND_TYPE FEATURE_FIND_NAME FEATURE_FIND_EXEC
 TAR FEATURE_TAR_CREATE FEATURE_TAR_GZIP GZIP GUNZIP ZCAT VI FEATURE_VI_COLON FEATURE_VI_SEARCH LESS MORE CLEAR RESET KILL PS
 FEATURE_FANCY_HEAD FEATURE_FANCY_TAIL FEATURE_SORT_BIG FEATURE_FIND_MAXDEPTH FEATURE_FIND_NOT FEATURE_FIND_PATH FEATURE_FIND_SIZE FEATURE_FIND_MTIME FEATURE_FIND_NEWER FEATURE_FIND_DELETE FEATURE_FIND_PAREN FEATURE_FIND_EXEC_PLUS FEATURE_CP_LONG_OPTIONS FEATURE_WC_LARGE FEATURE_XARGS_SUPPORT_CONFIRMATION FEATURE_XARGS_SUPPORT_QUOTES FEATURE_XARGS_SUPPORT_ZERO_TERM FEATURE_READLINK_FOLLOW FEATURE_TR_CLASSES FEATURE_DIFF_LONG_OPTIONS
 STTY TTY BASE64 NPROC TIMEOUT TRUNCATE REV NL PASTE FOLD
 LONG_OPTS FEATURE_HUMAN_READABLE FEATURE_PREFER_APPLETS FEATURE_SH_STANDALONE"

build() {
    make HOSTCC=gcc allnoconfig >/dev/null
    for opt in $applets; do
        sed -i "s/^# CONFIG_$opt is not set/CONFIG_$opt=y/" .config
    done
    yes "" | make HOSTCC=gcc oldconfig >/dev/null
    make -j"$JOBS" HOSTCC=gcc CC="$CC" AR="$AR" STRIP="$STRIP" SKIP_STRIP=y
}

wrappers="cat cp mv rm ls mkdir rmdir ln touch echo printf test [ true false pwd basename dirname head tail wc sort uniq cut tr tee seq yes sleep env expr
 chmod chown stat du md5sum sha1sum sha256sum od hexdump xxd dd cmp diff realpath readlink mktemp which xargs grep egrep fgrep sed awk find tar
 gzip gunzip zcat vi less more clear reset stty tty base64 nproc timeout truncate rev nl paste fold"

package() {
    install -Dm755 busybox "$pkgdir/usr/bin/busybox"
    for applet in $wrappers; do
        printf '#!/usr/bin/busybox\n' > "$pkgdir/usr/bin/$applet"
        chmod 755 "$pkgdir/usr/bin/$applet"
    done
}
