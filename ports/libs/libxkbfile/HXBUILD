pkgname=libxkbfile
pkgver=1.1.3
pkgdesc="XKB file handling library"
source="https://www.x.org/releases/individual/lib/libxkbfile-$pkgver.tar.xz"
sha256="a9b63eea997abb9ee6a8b4fbb515831c841f471af845a09de443b28003874bec"
builddir="libxkbfile-$pkgver"
depends="libX11"

build() {
    unset PKG_CONFIG_LIBDIR PKG_CONFIG_SYSROOT_DIR
    meson setup build $HX_MESON
    meson compile -C build -j "$JOBS"
}

package() {
    DESTDIR="$pkgdir" meson install -C build --no-rebuild
}
