pkgname=gtk3
pkgver=3.24.43
pkgdesc="GTK 3 toolkit, Wayland backend"
source="https://download.gnome.org/sources/gtk%2B/3.24/gtk%2B-$pkgver.tar.xz"
sha256="7e04f0648515034b806b74ae5d774d87cffb1a2a96c468cb5be476d51bf2f3c7"
builddir="gtk+-$pkgver"
depends="glib pango cairo gdk-pixbuf atk libepoxy wayland wayland-protocols libxkbcommon fribidi harfbuzz libX11 libXext libXi libXrandr libXcursor libXfixes libXcomposite libXdamage libXinerama"

build() {
    unset PKG_CONFIG_LIBDIR PKG_CONFIG_SYSROOT_DIR
    meson setup build $HX_MESON -Dx11_backend=true -Dwayland_backend=true -Dbroadway_backend=false \
        -Dintrospection=false -Dgtk_doc=false -Dman=false -Ddemos=false -Dexamples=false -Dtests=false \
        -Dinstalled_tests=false -Dprint_backends=file -Dcolord=no -Dcloudproviders=false -Dtracker3=false
    meson compile -C build -j "$JOBS"
}

package() {
    DESTDIR="$pkgdir" meson install -C build --no-rebuild
}
