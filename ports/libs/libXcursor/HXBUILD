pkgname=libXcursor
pkgver=1.2.3
pkgdesc="X cursor management library"
source="https://www.x.org/releases/individual/lib/libXcursor-$pkgver.tar.xz"
sha256="fde9402dd4cfe79da71e2d96bb980afc5e6ff4f8a7d74c159e1966afb2b2c2c0"
builddir="libXcursor-$pkgver"
depends="libXrender libXfixes"

build() {
    ./configure --host="$HX_HOST" --build="$HX_BUILD" --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --enable-shared --disable-static
    make -j"$JOBS"
}

package() {
    make DESTDIR="$pkgdir" install
}
