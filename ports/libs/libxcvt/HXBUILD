pkgname=libxcvt
pkgver=0.1.2
pkgdesc="VESA CVT mode line calculation"
source="https://www.x.org/releases/individual/lib/libxcvt-$pkgver.tar.xz"
sha256="0561690544796e25cfbd71806ba1b0d797ffe464e9796411123e79450f71db38"
builddir="libxcvt-$pkgver"
depends=""

build() {
    unset PKG_CONFIG_LIBDIR PKG_CONFIG_SYSROOT_DIR
    meson setup build $HX_MESON
    meson compile -C build -j "$JOBS"
}

package() {
    DESTDIR="$pkgdir" meson install -C build --no-rebuild
}
