pkgname=libXi
pkgver=1.8.2
pkgdesc="X Input extension library"
source="https://www.x.org/releases/individual/lib/libXi-$pkgver.tar.xz"
sha256="d0e0555e53d6e2114eabfa44226ba162d2708501a25e18d99cfb35c094c6c104"
builddir="libXi-$pkgver"
depends="libX11 libXext libXfixes"

build() {
    ./configure --host="$HX_HOST" --build="$HX_BUILD" --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --enable-shared --disable-static --disable-malloc0returnsnull --disable-docs --disable-specs --without-xmlto --without-fop --without-asciidoc
    make -j"$JOBS"
}

package() {
    make DESTDIR="$pkgdir" install
}
