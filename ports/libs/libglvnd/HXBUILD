pkgname=libglvnd
pkgver=1.7.0
pkgdesc="GL vendor-neutral dispatch: libEGL, libOpenGL, libGLESv2 that load Mesa"
source="https://gitlab.freedesktop.org/glvnd/libglvnd/-/archive/v$pkgver/libglvnd-v$pkgver.tar.gz"
sha256="2b6e15b06aafb4c0b6e2348124808cbd9b291c647299eaaba2e3202f51ff2f3d"
builddir="libglvnd-v$pkgver"
depends=""

build() {
    unset PKG_CONFIG_LIBDIR PKG_CONFIG_SYSROOT_DIR
    meson setup build $HX_MESON -Dc_args="-D__linux__ -D_GNU_SOURCE -I$HX_ROOT/usr/include" \
        -Dx11=disabled -Dglx=disabled -Degl=true -Dgles1=false -Dgles2=true -Dheaders=true
    meson compile -C build -j "$JOBS"
}

package() {
    DESTDIR="$pkgdir" meson install -C build --no-rebuild
}
