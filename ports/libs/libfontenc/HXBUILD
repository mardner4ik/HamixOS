pkgname=libfontenc
pkgver=1.1.8
pkgdesc="X font encoding library"
source="https://www.x.org/releases/individual/lib/libfontenc-$pkgver.tar.xz"
sha256="7b02c3d405236e0d86806b1de9d6868fe60c313628b38350b032914aa4fd14c6"
builddir="libfontenc-$pkgver"
depends="xorgproto zlib"

build() {
    ./configure --host="$HX_HOST" --build="$HX_BUILD" --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --enable-shared --disable-static --with-fontrootdir=/usr/share/fonts/X11
    make -j"$JOBS"
}

package() {
    make DESTDIR="$pkgdir" install
}
