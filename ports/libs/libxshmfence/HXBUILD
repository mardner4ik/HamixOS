pkgname=libxshmfence
pkgver=1.3.2
pkgdesc="Shared memory fences for X (futex based)"
source="https://www.x.org/releases/individual/lib/libxshmfence-$pkgver.tar.xz"
sha256="870df257bc40b126d91b5a8f1da6ca8a524555268c50b59c0acd1a27f361606f"
builddir="libxshmfence-$pkgver"
depends="xorgproto"

build() {
    ./configure --host="$HX_HOST" --build="$HX_BUILD" --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --enable-shared --disable-static --enable-futex --with-shared-memory-dir=/dev/shm
    make -j"$JOBS"
}

package() {
    make DESTDIR="$pkgdir" install
}
