pkgname=libXdamage
pkgver=1.1.6
pkgdesc="X Damage extension library"
source="https://www.x.org/releases/individual/lib/libXdamage-$pkgver.tar.xz"
sha256="52733c1f5262fca35f64e7d5060c6fcd81a880ba8e1e65c9621cf0727afb5d11"
builddir="libXdamage-$pkgver"
depends="libX11 libXfixes"

build() {
    ./configure --host="$HX_HOST" --build="$HX_BUILD" --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --enable-shared --disable-static --disable-malloc0returnsnull
    make -j"$JOBS"
}

package() {
    make DESTDIR="$pkgdir" install
}
