pkgname=mesa
pkgver=24.2.8
pkgdesc="OpenGL, OpenGL ES and EGL with the softpipe software renderer"
source="https://archive.mesa3d.org/mesa-$pkgver.tar.xz"
sha256="999d0a854f43864fc098266aaf25600ce7961318a1e2e358bff94a7f53580e30"
builddir="mesa-$pkgver"
depends="libglvnd libdrm expat zlib wayland wayland-protocols"

build() {
    unset PKG_CONFIG_LIBDIR PKG_CONFIG_SYSROOT_DIR
    meson setup build $HX_MESON -Dc_args="-D__linux__ -D_GNU_SOURCE -I$HX_ROOT/usr/include" -Dcpp_args="-D__linux__ -D_GNU_SOURCE -I$HX_ROOT/usr/include" -Dgallium-drivers=softpipe -Dvulkan-drivers= -Dplatforms=wayland \
        -Degl=enabled -Dgles1=disabled -Dgles2=enabled -Dopengl=true -Dglx=disabled -Dgbm=disabled \
        -Dllvm=disabled -Dshared-glapi=enabled -Dglvnd=enabled -Dvalgrind=disabled -Dlibunwind=disabled -Dzstd=disabled \
        -Dxmlconfig=disabled -Dgallium-va=disabled -Dgallium-vdpau=disabled -Dgallium-xa=disabled \
        -Dgallium-nine=false -Dgallium-opencl=disabled -Dgallium-rusticl=false -Dbuild-tests=false \
        -Dosmesa=false -Dvideo-codecs= -Dshader-cache=disabled -Dselinux=false -Dlmsensors=disabled
    meson compile -C build -j "$JOBS"
}

package() {
    DESTDIR="$pkgdir" meson install -C build --no-rebuild
}
