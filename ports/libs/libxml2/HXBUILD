pkgname=libxml2
pkgver=2.13.5
pkgdesc="XML parsing library"
source="https://download.gnome.org/sources/libxml2/2.13/libxml2-$pkgver.tar.xz"
sha256="74fc163217a3964257d3be39af943e08861263c4231f9ef5b496b6f6d4c7b2b6"
builddir="libxml2-$pkgver"
depends="zlib"

build() {
    unset PKG_CONFIG_LIBDIR PKG_CONFIG_SYSROOT_DIR
    meson setup build $HX_MESON -Dpython=false -Dreadline=false -Dhistory=false -Dicu=disabled
    meson compile -C build -j "$JOBS"
}

package() {
    DESTDIR="$pkgdir" meson install -C build --no-rebuild
}
