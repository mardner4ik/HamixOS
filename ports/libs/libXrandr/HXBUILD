pkgname=libXrandr
pkgver=1.5.4
pkgdesc="X Resize and Rotate extension library"
source="https://www.x.org/releases/individual/lib/libXrandr-$pkgver.tar.xz"
sha256="1ad5b065375f4a85915aa60611cc6407c060492a214d7f9daf214be752c3b4d3"
builddir="libXrandr-$pkgver"
depends="libX11 libXext libXrender"

build() {
    ./configure --host="$HX_HOST" --build="$HX_BUILD" --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --enable-shared --disable-static --disable-malloc0returnsnull
    make -j"$JOBS"
}

package() {
    make DESTDIR="$pkgdir" install
}
