pkgname=fltk
pkgver=1.3.9
pkgdesc="Fast Light Toolkit (X11) for dillo"
source="https://www.fltk.org/pub/fltk/$pkgver/fltk-$pkgver-source.tar.bz2"
sha256="103441134915402808fd45424d4061778609437e804334434e946cfd26b196c2"
builddir="fltk-$pkgver"
depends="libX11 libXext libXft libXrender libXfixes libXcursor libXinerama libpng zlib fontconfig libcxx"

build() {
    ./configure --host="$HX_HOST" --build="$HX_BUILD" --prefix=/usr --enable-shared --disable-gl --enable-xft \
        --enable-localjpeg --disable-localzlib --disable-localpng --disable-cairo --disable-xdbe \
        --x-includes="$HX_ROOT/usr/include" --x-libraries="$HX_ROOT/usr/lib"
    make -j"$JOBS" DIRS="jpeg src fluid"
}

package() {
    make -C src DESTDIR="$pkgdir" install
    make -C FL DESTDIR="$pkgdir" install
    install -Dm755 fltk-config "$pkgdir/usr/bin/fltk-config"
    rm -f "$pkgdir"/usr/lib/*.a
}
