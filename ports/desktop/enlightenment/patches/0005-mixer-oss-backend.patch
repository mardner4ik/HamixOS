+E_API extern const char *emix_backend_oss_name;
+#endif
 
 static int _log_domain;
 
@@ -111,6 +115,17 @@
         eina_array_push(ctx->backends, back);
         ctx->backends_names = eina_list_append(ctx->backends_names,
                                                back->backend_name);
